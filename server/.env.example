# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_manager"

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Anthropic (Claude) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+1...
TWILIO_PHONE_NUMBER=+1...

# ── Meta (Instagram) ─────────────────────────────────
META_APP_ID=...
META_APP_SECRET=...
META_VERIFY_TOKEN=...       # произвольная строка для верификации webhook
META_PAGE_ACCESS_TOKEN=...

# ── Deepgram (STT) ───────────────────────────────────
DEEPGRAM_API_KEY=...

# ── ElevenLabs (TTS) ────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID_RU=...  # ID голоса для русского
ELEVENLABS_VOICE_ID_KY=...  # ID голоса для кыргызского
